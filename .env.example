COMPOSE_PROJECT_NAME=sensorhub

APP_NAME=SensorHub
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost
APP_PORT=80

DB_DATABASE=sensorhub
DB_USERNAME=sensorhub
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-local-root-password
DB_FORWARD_PORT=3307

SESSION_DOMAIN=
SESSION_COOKIE=sensorhub_session
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost

VITE_API_URL=/api/v1
CHOKIDAR_USEPOLLING=true
